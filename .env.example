# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/medai"
DIRECT_URL="postgresql://postgres:password@localhost:5432/medai"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="change-this-to-another-long-random-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# Encryption (AES-256-GCM - must be 32 bytes hex = 64 chars)
ENCRYPTION_KEY="change-this-to-a-64-char-hex-string-for-aes256-encryption"

# Anthropic AI
ANTHROPIC_API_KEY="sk-ant-..."

# HPCSA API (Healthcare Professionals Council of South Africa)
HPCSA_API_URL="https://api.hpcsa.co.za/verify"
HPCSA_API_KEY="your-hpcsa-api-key"

# Google Maps (for doctor location)
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# SMS (Twilio - for SA OTP)
TWILIO_ACCOUNT_SID="your-twilio-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+27..."

# Push Notifications (Expo)
EXPO_ACCESS_TOKEN="your-expo-access-token"

# App
NODE_ENV="development"
PORT=3000
API_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:19006"

# AWS S3 (for encrypted document storage)
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret"
AWS_REGION="af-south-1"
AWS_S3_BUCKET="medai-encrypted-records"
