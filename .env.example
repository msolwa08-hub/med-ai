# ==============================================================================
# MedAI API environment — root example (local development defaults)
# ==============================================================================
# Copy to .env and fill in. Source of truth: apps/api/src/config.ts (zod schema —
# the API exits on boot if a REQUIRED var is missing or malformed).
# Never commit real secrets.

# ── App (optional — defaults shown) ──────────────────────────────────────────
# Runtime environment: development | test | production
NODE_ENV="development"
# Port the standalone API (apps/api/src/index.ts) listens on
PORT=3000
# Public URL of this API (used in links/callbacks)
API_URL="http://localhost:3000"
# URL of the client app, used for CORS (Expo dev server by default)
FRONTEND_URL="http://localhost:19006"

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma (docker-compose default shown)
DATABASE_URL="postgresql://postgres:password@localhost:5432/medai"
# Optional: direct (non-pooled) connection for Prisma migrations (needed with
# pooled providers like Supabase/pgBouncer; omit for plain Postgres)
DIRECT_URL="postgresql://postgres:password@localhost:5432/medai"

# ── Redis (optional — defaults to redis://localhost:6379) ────────────────────
# Used for sessions, caching and rate limiting
REDIS_URL="redis://localhost:6379"

# ── Auth / JWT (REQUIRED) ─────────────────────────────────────────────────────
# Generate each with: openssl rand -hex 32  (min 32 characters, use different values)
JWT_SECRET="REPLACE_WITH_64_CHAR_HEX_STRING"
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_64_CHAR_HEX_STRING"
# Optional token lifetimes (defaults: 7d / 30d)
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ── Encryption (REQUIRED) ─────────────────────────────────────────────────────
# Master key for AES-256-GCM per-consultation envelope encryption.
# Must be EXACTLY 64 hex characters (32 bytes). Generate: openssl rand -hex 32
ENCRYPTION_KEY="REPLACE_WITH_64_CHAR_HEX_STRING"

# ── Anthropic AI (REQUIRED) ───────────────────────────────────────────────────
# Claude API key for history taking, diagnosis, ultrasound interpretation, etc.
# Get one at console.anthropic.com → API Keys
ANTHROPIC_API_KEY="sk-ant-api03-REPLACE_ME"

# ── HPCSA verification (optional) ─────────────────────────────────────────────
# Doctor registration verification endpoint (default shown) + API key
HPCSA_API_URL="https://api.hpcsa.co.za/verify"
# HPCSA_API_KEY="your-hpcsa-api-key"

# ── Twilio SMS / OTP (optional — SMS features disabled if unset) ─────────────
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="your-twilio-auth-token"
# TWILIO_PHONE_NUMBER="+27000000000"

# ── AWS S3 encrypted document storage (optional) ──────────────────────────────
# AWS_ACCESS_KEY_ID="your-aws-access-key"
# AWS_SECRET_ACCESS_KEY="your-aws-secret"
# Region defaults to af-south-1 (Cape Town) for POPIA data residency
AWS_REGION="af-south-1"
AWS_S3_BUCKET="medai-encrypted-records"

# ── Expo push notifications (optional) ────────────────────────────────────────
# Access token for the Expo push API (expo.dev → Access tokens)
# EXPO_ACCESS_TOKEN="your-expo-access-token"

# ── Emergency profile QR (optional) ───────────────────────────────────────────
# HMAC-SHA256 signing secret for emergency QR links (falls back to ENCRYPTION_KEY)
# EMERGENCY_SECRET="REPLACE_WITH_RANDOM_32_CHAR_SECRET"
# Base URL embedded in emergency QR codes (default: https://medai.co.za)
# APP_BASE_URL="https://medai.co.za"

# ── PayFast payments (optional — sandbox defaults built in) ──────────────────
# Live merchant credentials from payfast.co.za → Settings → Integration.
# Defaults are the public PayFast sandbox credentials.
# PAYFAST_MERCHANT_ID="10000100"
# PAYFAST_MERCHANT_KEY="46f0cd694581a"
# Passphrase must match the one set in your PayFast dashboard
# PAYFAST_PASSPHRASE="your-payfast-passphrase"
# App URL used for payment return/cancel deep links (default: exp://localhost:8081)
# APP_URL="exp://localhost:8081"

# ── Beta access (optional) ────────────────────────────────────────────────────
# Comma-separated access keys for the hosted beta (default: MEDAI-BETA-DEV)
# BETA_ACCESS_KEYS="MEDAI-BETA-XXXX"          # patient / history-taker access
# BETA_DOCTOR_KEYS="MEDAI-DOC-XXXX"           # doctor cockpit + analytics
# BETA_TOOLS_KEYS="MEDAI-INTERN-XXXX"         # intern tools
# Branding used in the AI greeting/summaries (defaults: Dr. Patel / Sandton Family Practice)
# BETA_DOCTOR_NAME="Dr. Smith"
# BETA_PRACTICE_NAME="Cape Town City Practice"

# ── POPIA (optional) ──────────────────────────────────────────────────────────
# When "true", AI processing requires a granted, non-expired DATA_PROCESSING
# consent record (cross-border transfer, POPIA s72). Default: false.
ENFORCE_AI_PROCESSING_CONSENT="false"

# ── Lab result webhooks (optional) ────────────────────────────────────────────
# HMAC-SHA256 secrets validating inbound lab webhooks, per provider.
# LAB_WEBHOOK_SECRET is the generic fallback; unsigned webhooks are rejected in
# production when a secret is configured.
# LAB_WEBHOOK_SECRET="generic-hmac-secret"
# LAB_WEBHOOK_SECRET_LANCET="lancet-hmac-secret"
# LAB_WEBHOOK_SECRET_AMPATH="ampath-hmac-secret"
# LAB_WEBHOOK_SECRET_LAB24="lab24-hmac-secret"
# LAB_WEBHOOK_SECRET_PATHCARE="pathcare-hmac-secret"
# LAB_WEBHOOK_SECRET_NHLS="nhls-hmac-secret"
