# ==============================================================================
# MedAI API environment (apps/api) — hosted/managed-services flavour
# ==============================================================================
# Copy to apps/api/.env and fill in. Source of truth: apps/api/src/config.ts
# (zod schema — the API exits on boot if a REQUIRED var is missing/malformed).
# Never commit real secrets.

# ── App (optional — defaults shown) ──────────────────────────────────────────
NODE_ENV=development                      # development | test | production
PORT=3000                                 # standalone API port (src/index.ts)
API_URL=http://localhost:3000             # public URL of this API
FRONTEND_URL=http://localhost:19006       # client app URL, used for CORS

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
# Supabase: supabase.com → project → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Optional: direct (non-pooled) URL for Prisma migrations when DATABASE_URL is pooled
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ── Redis (optional — defaults to redis://localhost:6379) ────────────────────
# Upstash: upstash.com → your database → Details → Redis URL
REDIS_URL=rediss://:[YOUR-UPSTASH-PASSWORD]@[YOUR-UPSTASH-HOST].upstash.io:6379

# ── Auth / JWT (REQUIRED, min 32 chars each) ──────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_HEX_STRING
# Optional token lifetimes (defaults: 7d / 30d)
# JWT_EXPIRES_IN=7d
# JWT_REFRESH_EXPIRES_IN=30d

# ── Encryption (REQUIRED — exactly 64 hex chars / 32 bytes) ───────────────────
# Master key for AES-256-GCM per-consultation envelope encryption.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_STRING

# ── Anthropic AI (REQUIRED) ───────────────────────────────────────────────────
# console.anthropic.com → API Keys. Powers history taking, differentials,
# ultrasound interpretation, referral letters, etc.
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# ── HPCSA verification (optional) ─────────────────────────────────────────────
# HPCSA_API_URL=https://api.hpcsa.co.za/verify   # default shown
# HPCSA_API_KEY=your-hpcsa-api-key

# ── Twilio SMS / OTP (optional — skip for MVP testing) ────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+27000000000

# ── AWS S3 encrypted document storage (optional) ──────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=af-south-1                   # default — Cape Town, POPIA residency
# AWS_S3_BUCKET=medai-encrypted-records   # default

# ── Expo push notifications (optional) ────────────────────────────────────────
# expo.dev → Access tokens
# EXPO_ACCESS_TOKEN=

# ── Emergency profile QR (optional) ───────────────────────────────────────────
# HMAC signing secret for emergency QR links (falls back to ENCRYPTION_KEY)
# EMERGENCY_SECRET=REPLACE_WITH_RANDOM_32_CHAR_SECRET
# Base URL embedded in emergency QR codes (default: https://medai.co.za)
# APP_BASE_URL=https://medai.co.za

# ── PayFast payments (optional — public sandbox credentials are the default) ──
# Live credentials: payfast.co.za → Settings → Integration
# PAYFAST_MERCHANT_ID=10000100
# PAYFAST_MERCHANT_KEY=46f0cd694581a
# PAYFAST_PASSPHRASE=your-payfast-passphrase
# Deep-link base for payment return/cancel URLs (default: exp://localhost:8081)
# APP_URL=exp://localhost:8081

# ── Beta access keys (optional — change before going live) ────────────────────
# Comma-separated lists. Default patient key: MEDAI-BETA-DEV
# BETA_ACCESS_KEYS=MEDAI-BETA-XXXX        # patient / history-taker access
# BETA_DOCTOR_KEYS=MEDAI-DOC-XXXX         # doctor cockpit + analytics
# BETA_TOOLS_KEYS=MEDAI-INTERN-XXXX       # intern tools

# ── Beta server branding (optional) ───────────────────────────────────────────
# Shown in the AI greeting & summaries (defaults: Dr. Patel / Sandton Family Practice)
# BETA_DOCTOR_NAME=Dr. Smith
# BETA_PRACTICE_NAME=Cape Town City Practice

# ── POPIA (optional) ──────────────────────────────────────────────────────────
# "true" = AI processing requires a granted, non-expired DATA_PROCESSING consent
# record (cross-border transfer, POPIA s72). Default: false.
# ENFORCE_AI_PROCESSING_CONSENT=false

# ── Lab result webhooks (optional) ────────────────────────────────────────────
# Per-provider HMAC-SHA256 secrets; LAB_WEBHOOK_SECRET is the generic fallback.
# LAB_WEBHOOK_SECRET=
# LAB_WEBHOOK_SECRET_LANCET=
# LAB_WEBHOOK_SECRET_AMPATH=
# LAB_WEBHOOK_SECRET_LAB24=
# LAB_WEBHOOK_SECRET_PATHCARE=
# LAB_WEBHOOK_SECRET_NHLS=
