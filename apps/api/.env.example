# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:19006

# ── Database (Supabase) ───────────────────────────────────────────────
# Get these from: supabase.com → your project → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ── Redis (Upstash) ───────────────────────────────────────────────────
# Get this from: upstash.com → your database → Details → Redis URL
REDIS_URL=rediss://:[YOUR-UPSTASH-PASSWORD]@[YOUR-UPSTASH-HOST].upstash.io:6379

# ── JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ──
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_HEX_STRING

# ── Encryption (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ──
# Must be exactly 64 hex characters (32 bytes)
ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_STRING

# ── Anthropic API ─────────────────────────────────────────────────────
# Get this from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api...

# ── Optional: skip these for MVP testing ──────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# HPCSA_API_KEY=
