// Prisma Schema for MedAI - South African Medical AI Application
// All patient medical data is encrypted at the application layer before storage

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum PreferredLanguage {
  en   // English
  zu   // isiZulu
  xh   // isiXhosa
  af   // Afrikaans
  nso  // Sepedi / Northern Sotho
  tn   // Setswana
  st   // Sesotho
  ts   // Xitsonga
  ss   // Siswati
  ve   // Tshivenda
  nr   // isiNdebele
}

enum HpcsaStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum DoctorType {
  GP
  SPECIALIST
  ALLIED_HEALTH
  TRAVELLING
}

enum ConsultationStatus {
  HISTORY_TAKING
  DOCTOR_REVIEW
  EXAMINATION
  COMPLETED
  CANCELLED
}

enum ConsultationType {
  IN_PERSON
  TELECONSULT
  HOME_VISIT
}

enum InvestigationType {
  LAB
  RADIOLOGY
  ECG
  OTHER
}

enum InvestigationUrgency {
  ROUTINE
  URGENT
  STAT
}

enum ConsentType {
  VIEW_HISTORY
  TREATMENT
  DATA_PROCESSING
  RESEARCH
}

enum OtpPurpose {
  LOGIN
  REGISTER
  RESET_PASSWORD
  HPCSA_VERIFY
}

enum PracticeMode {
  OPEN_LOOP    // Data on MedAI cloud — doctor appears in patient marketplace
  CLOSED_LOOP  // Data on doctor's own cloud — private practice only
}

enum LabProvider {
  LANCET
  AMPATH
  LAB24
  PATHCARE
  NHLS
  OTHER
}

enum PrescriptionStatus {
  ISSUED
  DISPENSED
  CANCELLED
  EXPIRED
}

enum PatientLiteracyLevel {
  LOW       // Simple yes/no questions
  MEDIUM    // Everyday language
  HIGH      // Can handle clinical terminology
  UNKNOWN   // Not yet assessed (default)
}

// ============================================================
// MODELS
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String   @unique
  passwordHash String
  role         UserRole @default(PATIENT)
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient   Patient?
  doctor    Doctor?
  otps      OTP[]
  auditLogs AuditLog[]

  @@index([email])
  @@index([phone])
  @@map("users")
}

model Patient {
  id                       String            @id @default(cuid())
  userId                   String            @unique
  firstName                String
  lastName                 String
  dateOfBirth              DateTime
  gender                   Gender
  // AES-256-GCM encrypted fields (stored as base64 JSON: {encryptedData, iv, authTag})
  idNumber                 String?           // encrypted South African ID number
  nationalHealthInsurance  String?           // NHI number
  emergencyContact         String?           // encrypted JSON: {name, phone, relationship}
  preferredLanguage        PreferredLanguage @default(en)
  consentVersion           String?           // version of consent form accepted
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  consultations     Consultation[]
  consentRecords    ConsentRecord[]
  reviews           Review[]
  literacy          PatientLiteracy?
  emergencyProfile  EmergencyProfile?
  labAccounts       PatientLabAccount[]
  labResults        LabResult[]

  @@index([userId])
  @@map("patients")
}

model Doctor {
  id                 String      @id @default(cuid())
  userId             String      @unique
  firstName          String
  lastName           String
  hpcsaNumber        String      @unique
  hpcsaStatus        HpcsaStatus @default(PENDING)
  specialization     String?
  qualifications     Json?       // array of {degree, institution, year}
  practiceNumber     String?
  doctorType         DoctorType  @default(GP)
  isAvailable        Boolean     @default(false)
  currentLat         Float?
  currentLng         Float?
  availabilityRadius Float       @default(10) // km
  consultationFee    Float?
  profilePhoto       String?     // S3 key
  bio                String?
  languages          String[]    // array of PreferredLanguage codes
  rating             Float       @default(0)
  totalReviews       Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  consultations     Consultation[]
  availabilityLogs  DoctorAvailabilityLog[]
  consentRecords    ConsentRecord[]
  reviews           Review[]
  settings          DoctorSettings?
  incentiveScore    DoctorIncentiveScore?

  @@index([userId])
  @@index([hpcsaNumber])
  @@index([isAvailable, currentLat, currentLng])
  @@map("doctors")
}

model DoctorAvailabilityLog {
  id          String   @id @default(cuid())
  doctorId    String
  lat         Float
  lng         Float
  isAvailable Boolean
  timestamp   DateTime @default(now())

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, timestamp])
  @@map("doctor_availability_logs")
}

model Consultation {
  id               String             @id @default(cuid())
  patientId        String
  doctorId         String?
  startedAt        DateTime           @default(now())
  completedAt      DateTime?
  status           ConsultationStatus @default(HISTORY_TAKING)
  consultationType ConsultationType   @default(IN_PERSON)
  // Per-consultation encryption key, itself encrypted with master key
  encryptedDataKey String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  patient              Patient               @relation(fields: [patientId], references: [id])
  doctor               Doctor?               @relation(fields: [doctorId], references: [id])
  medicalHistory        MedicalHistory?
  differentialDiagnosis DifferentialDiagnosis?
  examinationFindings   ExaminationFindings?
  investigations        Investigation[]
  managementPlan        ManagementPlan?
  consentRecords        ConsentRecord[]
  reviews               Review[]
  prescriptions         Prescription[]
  labResults            LabResult[]

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@map("consultations")
}

model MedicalHistory {
  id                    String               @id @default(cuid())
  consultationId        String               @unique
  language              PreferredLanguage    @default(en)
  literacyLevel         PatientLiteracyLevel @default(UNKNOWN)
  // All fields below are AES-256-GCM encrypted with consultation data key
  chiefComplaint        String    // encrypted
  historyOfPresentIllness String  // encrypted
  pastMedicalHistory    String    // encrypted
  medications           String    // encrypted
  allergies             String    // encrypted
  familyHistory         String    // encrypted
  socialHistory         String    // encrypted
  systemsReview         String    // encrypted
  clinicalScores        String?   // encrypted — validated clinical scores (CRB-65, IPSS, PHQ-9, etc.)
  opportunisticFindings String?   // encrypted — health promotion / screening findings
  redFlagsIdentified    String?   // encrypted — red flag symptoms noted
  aiConversationLog     String    // encrypted JSON - full AI conversation
  doctorConfirmed       Boolean   @default(false)
  doctorNotes           String?   // encrypted
  confirmedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@map("medical_histories")
}

model DifferentialDiagnosis {
  id                     String    @id @default(cuid())
  consultationId         String    @unique
  // JSON array: [{diagnosis, icdCode, probability, reasoning}]
  diagnoses              Json
  aiModel                String
  generatedAt            DateTime  @default(now())
  doctorReviewed         Boolean   @default(false)
  doctorSelectedDiagnosis String?
  doctorNotes            String?
  reviewedAt             DateTime?

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@map("differential_diagnoses")
}

model ExaminationFindings {
  id             String   @id @default(cuid())
  consultationId String   @unique
  // All fields encrypted with consultation data key
  vitalSigns     String   // encrypted JSON: {bp, hr, rr, temp, spo2, weight, height}
  generalExam    String   // encrypted
  systemicExam   String   // encrypted JSON: {cvs, resp, abdo, neuro, msk}
  doctorNotes    String?  // encrypted
  recordedAt     DateTime @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@map("examination_findings")
}

model Investigation {
  id                   String               @id @default(cuid())
  consultationId       String
  type                 InvestigationType
  name                 String
  urgency              InvestigationUrgency @default(ROUTINE)
  specialInstructions  String?
  encryptedResult      String?              // encrypted result data
  resultDate           DateTime?
  uploadedFileKey      String?              // encrypted S3 key
  requestedBy          String               // doctorId
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@map("investigations")
}

model ManagementPlan {
  id                  String   @id @default(cuid())
  consultationId      String   @unique
  // All fields encrypted with consultation data key
  diagnosis           String   // encrypted
  medications         String   // encrypted JSON array: [{name, dose, frequency, duration, route}]
  procedures          String?  // encrypted
  referrals           String?  // encrypted JSON: [{specialty, reason, urgency}]
  followUpDays        Int?     // number of days for follow-up
  followUpDate        String?  // ISO date string
  patientInstructions String?  // encrypted patient-facing instructions
  doctorNotes         String?  // encrypted
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@map("management_plans")
}

model ConsentRecord {
  id             String      @id @default(cuid())
  patientId      String
  doctorId       String?
  consultationId String?
  consentType    ConsentType
  granted        Boolean
  grantedAt      DateTime    @default(now())
  expiresAt      DateTime?
  ipAddress      String?
  deviceInfo     String?
  createdAt      DateTime    @default(now())

  patient      Patient       @relation(fields: [patientId], references: [id])
  doctor       Doctor?       @relation(fields: [doctorId], references: [id])
  consultation Consultation? @relation(fields: [consultationId], references: [id])

  @@index([patientId, doctorId, consentType])
  @@index([patientId, consultationId])
  @@map("consent_records")
}

model Review {
  id             String   @id @default(cuid())
  patientId      String
  doctorId       String
  consultationId String
  rating         Int      // 1-5
  comment        String?
  createdAt      DateTime @default(now())

  patient      Patient      @relation(fields: [patientId], references: [id])
  doctor       Doctor       @relation(fields: [doctorId], references: [id])
  consultation Consultation @relation(fields: [consultationId], references: [id])

  @@unique([patientId, consultationId]) // one review per consultation
  @@index([doctorId])
  @@map("reviews")
}

model OTP {
  id        String     @id @default(cuid())
  userId    String
  code      String
  purpose   OtpPurpose
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int        @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("otps")
}

// ─────────────────────────────────────────────────────────
// Doctor Settings (practice mode, open vs closed loop)
// ─────────────────────────────────────────────────────────

model DoctorSettings {
  id              String      @id @default(cuid())
  doctorId        String      @unique
  doctor          Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  practiceMode    PracticeMode @default(OPEN_LOOP)
  // Closed-loop: doctor's own cloud storage
  cloudProvider   String?     // 'aws' | 'azure' | 'gcp'
  cloudBucket     String?
  cloudRegion     String?
  cloudAccessKey  String?     // encrypted
  cloudSecretKey  String?     // encrypted
  updatedAt       DateTime    @updatedAt

  @@map("doctor_settings")
}

// ─────────────────────────────────────────────────────────
// Doctor Incentive Score (priority ranking)
// ─────────────────────────────────────────────────────────

model DoctorIncentiveScore {
  id                String   @id @default(cuid())
  doctorId          String   @unique
  doctor            Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  totalPoints       Int      @default(0)
  completionRate    Float    @default(0)   // % of consultations with full SOAP
  streakDays        Int      @default(0)   // consecutive days with completed records
  priorityBoost     Float    @default(1.0) // multiplier for search ranking
  lastCalculated    DateTime @default(now())

  @@map("doctor_incentive_scores")
}

// ─────────────────────────────────────────────────────────
// Patient Literacy Level (for adaptive AI history)
// ─────────────────────────────────────────────────────────

model PatientLiteracy {
  id             String               @id @default(cuid())
  patientId      String               @unique
  patient        Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  level          PatientLiteracyLevel @default(UNKNOWN)
  assessedAt     DateTime?
  educationYears Int?
  selfReported   Boolean              @default(false)

  @@map("patient_literacy")
}

// ─────────────────────────────────────────────────────────
// Emergency Profile (always accessible, quick QR access)
// ─────────────────────────────────────────────────────────

model EmergencyProfile {
  id                    String   @id @default(cuid())
  patientId             String   @unique
  patient               Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  bloodType             String?
  // Encrypted but accessible via QR emergency token
  encryptedAllergies    String?
  encryptedMedications  String?
  encryptedConditions   String?
  encryptedContacts     String?
  organDonor            Boolean  @default(false)
  // QR code emergency access
  emergencyAccessToken  String?  @unique // hashed token for QR code
  isEnabled             Boolean  @default(true)
  updatedAt             DateTime @updatedAt

  @@map("emergency_profiles")
}

// ─────────────────────────────────────────────────────────
// Lab Integration (Lancet, Ampath, Lab24, Pathcare, NHLS)
// ─────────────────────────────────────────────────────────

model PatientLabAccount {
  id               String      @id @default(cuid())
  patientId        String
  patient          Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider         LabProvider
  providerPatientId String     // patient ID at the lab
  encryptedAccessToken String? // encrypted OAuth/API token
  isActive         Boolean     @default(true)
  linkedAt         DateTime    @default(now())
  lastSyncAt       DateTime?
  labResults       LabResult[]

  @@unique([patientId, provider])
  @@map("patient_lab_accounts")
}

model LabResult {
  id               String      @id @default(cuid())
  patientId        String
  patient          Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultationId   String?
  consultation     Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  labAccountId     String
  labAccount       PatientLabAccount @relation(fields: [labAccountId], references: [id], onDelete: Cascade)
  provider         LabProvider
  externalResultId String
  testName         String
  collectedAt      DateTime
  reportedAt       DateTime?
  // Encrypted structured results JSON
  encryptedResults String
  // S3 key for raw PDF report (encrypted)
  encryptedPdfKey  String?
  isAbnormal       Boolean     @default(false)
  importedAt       DateTime    @default(now())

  @@unique([provider, externalResultId])
  @@index([patientId, collectedAt])
  @@index([consultationId])
  @@map("lab_results")
}

// ─────────────────────────────────────────────────────────
// ICD-10 Codes (seeded from WHO ICD-10 + SA customisations)
// ─────────────────────────────────────────────────────────

model ICD10Code {
  code        String     @id   // e.g., "J18.9"
  description String
  category    String?          // chapter name
  blockCode   String?          // e.g., "J10-J18"
  isLeaf      Boolean    @default(true)
  parentCode  String?
  parent      ICD10Code? @relation("ICD10Hierarchy", fields: [parentCode], references: [code])
  children    ICD10Code[] @relation("ICD10Hierarchy")
  stgEntry    STGEntry?

  @@index([description])
  @@index([category])
  @@map("icd10_codes")
}

// ─────────────────────────────────────────────────────────
// Standard Treatment Guidelines (SA DoH STGs)
// ─────────────────────────────────────────────────────────

model STGEntry {
  id              String    @id @default(cuid())
  icd10Code       String    @unique
  icd10           ICD10Code @relation(fields: [icd10Code], references: [code])
  conditionName   String
  synonyms        String[]  @default([])
  category        String    // "Respiratory", "Cardiovascular", etc.
  subCategory     String?
  levelOfCare     String    // "Primary", "Secondary", "Tertiary", "All"
  edition         String    @default("8th Edition 2023")
  // JSON arrays of treatment info
  firstLineTreatment   Json  // [{medication, dose, route, frequency, duration, notes}]
  alternativeTreatment Json? // [{medication, dose, route, frequency, duration, notes, indication}]
  investigations  Json      // [{name, urgency: "ROUTINE|URGENT|STAT", rationale}]
  referralCriteria String?
  redFlags        String?   // comma-separated red flag symptoms
  followUpAdvice  String?
  notes           String?
  saPrevalence    String?   // "Common", "Uncommon", "Rare in SA"
  updatedAt       DateTime  @updatedAt

  @@index([conditionName])
  @@index([category])
  @@map("stg_entries")
}

// ─────────────────────────────────────────────────────────
// Prescriptions / Scripts
// ─────────────────────────────────────────────────────────

model Prescription {
  id              String             @id @default(cuid())
  consultationId  String
  consultation    Consultation       @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  doctorId        String
  patientId       String
  scriptNumber    String             @unique // sequential: MedAI-2026-000001
  issueDate       DateTime           @default(now())
  validUntilDate  DateTime?
  // Encrypted prescription items JSON
  encryptedItems  String             // [{name, dose, route, frequency, duration, quantity, instructions, isScheduled}]
  containsDDA     Boolean            @default(false) // Dangerous Drugs Act scheduled substances
  isRepeat        Boolean            @default(false)
  repeatTotal     Int                @default(0)
  repeatRemaining Int                @default(0)
  // Generated PDF
  pdfS3Key        String?
  status          PrescriptionStatus @default(ISSUED)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([consultationId])
  @@index([patientId, issueDate])
  @@index([doctorId, issueDate])
  @@map("prescriptions")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // e.g., "VIEW_MEDICAL_HISTORY", "UPDATE_CONSULTATION"
  resource   String   // e.g., "MedicalHistory", "Consultation"
  resourceId String?
  metadata   Json?    // additional context
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}
